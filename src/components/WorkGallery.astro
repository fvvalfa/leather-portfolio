---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  images: ImageMetadata[];
  title: string;
}

const { images, title } = Astro.props;
---

{
  images.length > 0 && (
    <div class="work-gallery mb-12" data-gallery>
      <!-- Основное фото -->
      <div class="relative rounded-xl overflow-hidden border border-leather-200 bg-leather-100 mb-4">
        <button
          type="button"
          class="block w-full cursor-zoom-in"
          data-open-lightbox
          aria-label="Открыть фото в полном размере"
        >
          <Image
            src={images[0]}
            alt={`${title} — фото 1`}
            class="w-full h-auto max-h-[70vh] object-contain mx-auto block"
            data-main-image
          />
        </button>

        {images.length > 1 && (
          <>
            <button
              type="button"
              class="gallery-prev absolute left-3 top-1/2 -translate-y-1/2 z-20 w-10 h-10 rounded-full bg-white/90 text-leather-800 shadow hover:bg-white transition flex items-center justify-center text-lg"
              aria-label="Предыдущее фото"
            >
              ←
            </button>
            <button
              type="button"
              class="gallery-next absolute right-3 top-1/2 -translate-y-1/2 z-20 w-10 h-10 rounded-full bg-white/90 text-leather-800 shadow hover:bg-white transition flex items-center justify-center text-lg"
              aria-label="Следующее фото"
            >
              →
            </button>
            <div class="absolute bottom-3 right-3 z-20 px-2.5 py-1 rounded-full bg-black/50 text-white text-xs">
              <span data-counter>1</span> / {images.length}
            </div>
          </>
        )}
      </div>

      <!-- Превью -->
      {images.length > 1 && (
        <div class="flex gap-2 overflow-x-auto pb-1">
          {images.map((img, index) => (
            <button
              type="button"
              class:list={[
                'gallery-thumb shrink-0 w-16 h-16 md:w-20 md:h-20 rounded-lg overflow-hidden border-2 transition',
                index === 0
                  ? 'border-leather-800 opacity-100'
                  : 'border-transparent opacity-70 hover:opacity-100',
              ]}
              data-thumb-index={index}
              aria-label={`Фото ${index + 1}`}
            >
              <Image src={img} alt="" class="w-full h-full object-cover" />
            </button>
          ))}
        </div>
      )}

      <script
        type="application/json"
        data-gallery-sources
        set:html={JSON.stringify(images.map((img) => img.src))}
      />
    </div>
  )
}

<!-- Lightbox overlay -->
<div
  id="lightbox"
  class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/90"
  role="dialog"
  aria-modal="true"
  aria-label="Просмотр фото"
>
  <button
    type="button"
    class="absolute top-4 right-4 z-10 w-11 h-11 rounded-full bg-white/10 text-white hover:bg-white/20 transition flex items-center justify-center text-2xl"
    data-lightbox-close
    aria-label="Закрыть"
  >
    ×
  </button>

  <button
    type="button"
    class="absolute left-3 md:left-6 top-1/2 -translate-y-1/2 z-10 w-11 h-11 rounded-full bg-white/10 text-white hover:bg-white/20 transition flex items-center justify-center text-xl"
    data-lightbox-prev
    aria-label="Предыдущее"
  >
    ←
  </button>

  <button
    type="button"
    class="absolute right-3 md:right-6 top-1/2 -translate-y-1/2 z-10 w-11 h-11 rounded-full bg-white/10 text-white hover:bg-white/20 transition flex items-center justify-center text-xl"
    data-lightbox-next
    aria-label="Следующее"
  >
    →
  </button>

  <img
    data-lightbox-image
    src=""
    alt=""
    class="max-h-[90vh] max-w-[92vw] object-contain select-none"
  />

  <div class="absolute bottom-5 left-1/2 -translate-x-1/2 px-3 py-1.5 rounded-full bg-black/60 text-white text-sm">
    <span data-lightbox-counter>1</span>
  </div>
</div>

<script>
  function initGalleries() {
    document.querySelectorAll('[data-gallery]').forEach((gallery) => {
      const root = gallery as HTMLElement;
      const main = root.querySelector('[data-main-image]') as HTMLImageElement | null;
      const thumbs = root.querySelectorAll('[data-thumb-index]');
      const prevBtn = root.querySelector('.gallery-prev');
      const nextBtn = root.querySelector('.gallery-next');
      const counter = root.querySelector('[data-counter]');
      const sourcesEl = root.querySelector('[data-gallery-sources]');
      const openBtn = root.querySelector('[data-open-lightbox]');

      if (!main || !sourcesEl) return;

      let sources: string[] = [];
      try {
        sources = JSON.parse(sourcesEl.textContent || '[]');
      } catch {
        return;
      }

      const total = sources.length;
      let current = 0;
      if (total === 0) return;

      function show(index: number) {
        current = (index + total) % total;
        main!.src = sources[current];
        main!.alt = `Фото ${current + 1}`;

        thumbs.forEach((el, i) => {
          if (i === current) {
            el.classList.add('border-leather-800', 'opacity-100');
            el.classList.remove('border-transparent', 'opacity-70');
          } else {
            el.classList.add('border-transparent', 'opacity-70');
            el.classList.remove('border-leather-800', 'opacity-100');
          }
        });

        if (counter) counter.textContent = String(current + 1);
      }

      prevBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        show(current - 1);
      });
      nextBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        show(current + 1);
      });
      thumbs.forEach((thumb) => {
        thumb.addEventListener('click', () => {
          const i = Number(thumb.getAttribute('data-thumb-index'));
          show(i);
        });
      });

      // Lightbox
      const lightbox = document.getElementById('lightbox');
      const lbImage = lightbox?.querySelector('[data-lightbox-image]') as HTMLImageElement | null;
      const lbCounter = lightbox?.querySelector('[data-lightbox-counter]');
      const lbClose = lightbox?.querySelector('[data-lightbox-close]');
      const lbPrev = lightbox?.querySelector('[data-lightbox-prev]');
      const lbNext = lightbox?.querySelector('[data-lightbox-next]');

      function openLightbox(index: number) {
        if (!lightbox || !lbImage) return;
        current = index;
        lbImage.src = sources[current];
        lbImage.alt = `Фото ${current + 1}`;
        if (lbCounter) lbCounter.textContent = `${current + 1} / ${total}`;
        lightbox.classList.remove('hidden');
        lightbox.classList.add('flex');
        document.body.style.overflow = 'hidden';
      }

      function closeLightbox() {
        if (!lightbox) return;
        lightbox.classList.add('hidden');
        lightbox.classList.remove('flex');
        document.body.style.overflow = '';
      }

      function lbShow(index: number) {
        current = (index + total) % total;
        if (lbImage) {
          lbImage.src = sources[current];
          lbImage.alt = `Фото ${current + 1}`;
        }
        if (lbCounter) lbCounter.textContent = `${current + 1} / ${total}`;
        // Синхронизируем и основную галерею
        show(current);
      }

      openBtn?.addEventListener('click', () => openLightbox(current));
      lbClose?.addEventListener('click', closeLightbox);
      lbPrev?.addEventListener('click', () => lbShow(current - 1));
      lbNext?.addEventListener('click', () => lbShow(current + 1));

      lightbox?.addEventListener('click', (e) => {
        if (e.target === lightbox) closeLightbox();
      });

      document.addEventListener('keydown', (e) => {
        if (lightbox?.classList.contains('hidden')) return;
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowLeft') lbShow(current - 1);
        if (e.key === 'ArrowRight') lbShow(current + 1);
      });
    });
  }

  initGalleries();
  document.addEventListener('astro:page-load', initGalleries);
</script>