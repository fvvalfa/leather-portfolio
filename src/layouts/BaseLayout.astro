---
import '../styles/global.css';
import { categoryList } from '../lib/categories';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Изделия из кожи ручной работы',
  description = 'Портфолио кожевенных изделий ручной работы',
  image,
} = Astro.props;

const site = Astro.site ?? new URL('https://leather.f-v-v.ru');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = image ? new URL(image, site).href : undefined;

const path = Astro.url.pathname;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="Изделия из кожи ручной работы" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body class="min-h-screen flex flex-col bg-leather-50 text-leather-900">
    <header class="fixed top-0 inset-x-0 z-50 bg-leather-50/80 backdrop-blur-md border-b border-leather-200/60">
      <div class="w-full px-5 md:px-10 xl:px-16 h-16 md:h-20 flex items-center justify-between">
        <a href="/" class="font-semibold text-base md:text-lg tracking-tight text-leather-800">
          Кожа · Ручная работа
        </a>

        <nav class="hidden md:flex items-center gap-8 lg:gap-10 text-sm font-medium text-leather-700">
          <a
            href="/"
            class:list={[
              'hover:text-leather-900 transition',
              path === '/' && 'text-leather-900 font-semibold',
            ]}
          >
            Главная
          </a>

          <div class="relative group">
            <a
              href="/works"
              class:list={[
                'hover:text-leather-900 transition inline-flex items-center gap-1',
                path.startsWith('/works') && 'text-leather-900 font-semibold',
              ]}
            >
              Работы
              <svg class="w-4 h-4 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </a>
            <div class="invisible opacity-0 group-hover:visible group-hover:opacity-100 transition absolute top-full left-0 pt-2">
              <div class="bg-white border border-leather-200 rounded-lg shadow-lg py-2 min-w-[200px]">
                <a href="/works" class="block px-4 py-2 hover:bg-leather-50">Все работы</a>
                {categoryList.map((cat) => (
                  <a href={`/works/${cat.id}`} class="block px-4 py-2 hover:bg-leather-50">
                    {cat.label}
                  </a>
                ))}
              </div>
            </div>
          </div>

          <a
            href="/about"
            class:list={[
              'hover:text-leather-900 transition',
              path === '/about' && 'text-leather-900 font-semibold',
            ]}
          >
            О мастере
          </a>

          <a
            href="/contacts"
            class:list={[
              'hover:text-leather-900 transition',
              path === '/contacts' && 'text-leather-900 font-semibold',
            ]}
          >
            Контакты
          </a>
        </nav>

        <button id="menu-btn" class="md:hidden p-2 text-leather-800" aria-label="Меню" aria-expanded="false">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

      <div id="mobile-menu" class="hidden md:hidden border-t border-leather-200 bg-leather-50">
        <nav class="flex flex-col px-5 py-4 text-sm font-medium text-leather-700">
          <a
            href="/"
            class:list={['py-3', path === '/' && 'text-leather-900 font-semibold']}
          >
            Главная
          </a>
          <a
            href="/works"
            class:list={['py-3', path.startsWith('/works') && 'text-leather-900 font-semibold']}
          >
            Все работы
          </a>
          {categoryList.map((cat) => (
            <a
              href={`/works/${cat.id}`}
              class:list={[
                'py-2 pl-4 text-leather-600',
                path === `/works/${cat.id}` && 'text-leather-900 font-semibold',
              ]}
            >
              {cat.label}
            </a>
          ))}
          <a
            href="/about"
            class:list={['py-3', path === '/about' && 'text-leather-900 font-semibold']}
          >
            О мастере
          </a>
          <a
            href="/contacts"
            class:list={['py-3', path === '/contacts' && 'text-leather-900 font-semibold']}
          >
            Контакты
          </a>
        </nav>
      </div>
    </header>

    <main class="flex-1 pt-16 md:pt-20">
      <slot />
    </main>

    <footer class="border-t border-leather-200">
      <div class="w-full px-5 md:px-10 xl:px-16 py-10 text-sm text-leather-600 flex flex-col sm:flex-row justify-between gap-4">
        <p>© {new Date().getFullYear()} Изделия из кожи ручной работы</p>
        <p>Сделано с вниманием к деталям</p>
      </div>
    </footer>

    <!-- Кнопка наверх -->
    <button
      id="back-to-top"
      type="button"
      class="fixed bottom-6 right-6 z-40 w-11 h-11 rounded-full bg-leather-800 text-white shadow-lg opacity-0 pointer-events-none translate-y-2 transition-all duration-300 hover:bg-leather-900 flex items-center justify-center"
      aria-label="Наверх"
    >
      ↑
    </button>

    <script>
      const btn = document.getElementById('menu-btn');
      const menu = document.getElementById('mobile-menu');

      function closeMenu() {
        menu?.classList.add('hidden');
        btn?.setAttribute('aria-expanded', 'false');
      }

      function toggleMenu() {
        const isHidden = menu?.classList.toggle('hidden');
        btn?.setAttribute('aria-expanded', isHidden ? 'false' : 'true');
      }

      btn?.addEventListener('click', toggleMenu);

      menu?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', closeMenu);
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeMenu();
      });

      // Кнопка «Наверх»
      const backToTop = document.getElementById('back-to-top');

      window.addEventListener('scroll', () => {
        if (!backToTop) return;
        const show = window.scrollY > 400;
        backToTop.classList.toggle('opacity-0', !show);
        backToTop.classList.toggle('pointer-events-none', !show);
        backToTop.classList.toggle('translate-y-2', !show);
      });

      backToTop?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    </script>
  </body>
</html>