---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCategoryLabel } from '../lib/categories';

const featuredWorks = (
  await getCollection(
    'works',
    (entry) => !entry.data.draft && entry.data.featured
  )
)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);
---

<BaseLayout title="Главная — Изделия из кожи">
  <!-- Hero -->
  <section class="max-w-6xl mx-auto px-4 py-20 md:py-28">
    <div class="max-w-2xl">
      <p class="text-leather-600 text-sm font-medium tracking-wide uppercase mb-4">
        Ручная работа
      </p>
      <h1 class="text-4xl md:text-5xl font-semibold tracking-tight text-leather-900 leading-tight mb-6">
        Изделия из кожи<br />с характером
      </h1>
      <p class="text-lg text-leather-700 leading-relaxed mb-10">
        Кошельки, ремни, сумки и аксессуары. Каждое изделие изготавливается вручную
        из качественной кожи с вниманием к деталям и долговечности.
      </p>
      <div class="flex flex-wrap gap-4">
        <a
          href="/works"
          class="inline-flex items-center px-6 py-3 rounded-lg bg-leather-800 text-white font-medium hover:bg-leather-900 transition"
        >
          Смотреть работы
        </a>
        <a
          href="/contacts"
          class="inline-flex items-center px-6 py-3 rounded-lg border border-leather-300 text-leather-800 font-medium hover:bg-leather-100 transition"
        >
          Связаться
        </a>
      </div>
    </div>
  </section>

  <!-- Избранные работы (masonry) -->
  {featuredWorks.length > 0 && (
    <section class="max-w-6xl mx-auto px-4 pb-20">
      <div class="flex items-end justify-between mb-10">
        <h2 class="text-2xl font-semibold text-leather-900">Избранные работы</h2>
        <a
          href="/works"
          class="text-sm font-medium text-leather-600 hover:text-leather-900 transition"
        >
          Все работы →
        </a>
      </div>

      <div class="masonry">
        {featuredWorks.map((work) => (
          <a
            href={`/works/${work.data.category}/${work.id}`}
            class="masonry-item group block rounded-xl overflow-hidden border border-leather-200 bg-white hover:shadow-lg transition"
          >
            <div class="overflow-hidden bg-leather-100">
              <Image
                src={work.data.cover}
                alt={work.data.title}
                class="w-full h-auto object-cover group-hover:scale-[1.03] transition duration-500"
              />
            </div>
            <div class="p-5">
              <p class="text-xs text-leather-500 mb-1">
                {getCategoryLabel(work.data.category)}
              </p>
              <h3 class="font-semibold text-leather-900 mb-1 group-hover:text-leather-700 transition">
                {work.data.title}
              </h3>
              <p class="text-sm text-leather-600 line-clamp-2">
                {work.data.description}
              </p>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>