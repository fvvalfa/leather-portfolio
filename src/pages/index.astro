---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCategoryLabel } from '../lib/categories';

const featuredWorks = (
  await getCollection('works', (entry) => !entry.data.draft && entry.data.featured)
)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 8);

const heroWork = featuredWorks[0];
---

<BaseLayout title="Главная — Изделия из кожи">
  {/* Полноэкранный hero */}
  <section class="relative min-h-[calc(100svh-4rem)] md:min-h-[calc(100svh-5rem)] flex items-end">
    {heroWork ? (
      <div class="absolute inset-0">
        <Image
          src={heroWork.data.cover}
          alt={heroWork.data.title}
          class="w-full h-full object-cover"
          loading="eager"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-leather-950/80 via-leather-900/40 to-leather-900/20" />
      </div>
    ) : (
      <div class="absolute inset-0 bg-leather-200" />
    )}

    <div class="relative z-10 w-full px-5 md:px-10 xl:px-16 pb-16 md:pb-24 pt-10">
      <p class="text-leather-200 text-sm font-medium tracking-[0.2em] uppercase mb-4">
        Ручная работа
      </p>
      <h1 class="text-4xl sm:text-5xl md:text-6xl xl:text-7xl font-semibold tracking-tight text-white leading-[1.05] max-w-4xl mb-8">
        Изделия из кожи<br />с характером
      </h1>
      <div class="flex flex-wrap gap-4">
        <a
          href="/works"
          class="inline-flex px-7 py-3.5 rounded-lg bg-leather-50 text-leather-900 font-medium hover:bg-white transition"
        >
          Смотреть работы
        </a>
        <a
          href="/contacts"
          class="inline-flex px-7 py-3.5 rounded-lg border border-white/50 text-white font-medium hover:bg-white/10 transition"
        >
          Связаться
        </a>
      </div>
    </div>
  </section>

  {/* Сетка на всю ширину */}
  {featuredWorks.length > 0 && (
    <section class="w-full px-5 md:px-10 xl:px-16 py-16 md:py-24">
      <div class="flex items-end justify-between mb-10">
        <h2 class="text-2xl md:text-3xl font-semibold text-leather-900">Избранные работы</h2>
        <a href="/works" class="text-sm font-medium text-leather-600 hover:text-leather-900 transition">
          Все работы →
        </a>
      </div>

      <div class="masonry">
        {featuredWorks.map((work) => (
          <a
            href={`/works/${work.data.category}/${work.id}`}
            class="masonry-item group block"
          >
            <div class="overflow-hidden bg-leather-100 mb-3">
              <Image
                src={work.data.cover}
                alt={work.data.title}
                class="w-full h-auto object-cover group-hover:scale-[1.02] transition duration-500"
              />
            </div>
            <p class="text-xs text-leather-500 mb-0.5">
              {getCategoryLabel(work.data.category)}
            </p>
            <h3 class="font-medium text-leather-900 group-hover:text-leather-700 transition">
              {work.data.title}
            </h3>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>