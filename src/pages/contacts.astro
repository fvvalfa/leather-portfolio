---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Контакты — Изделия из кожи">
  <section class="max-w-4xl mx-auto px-4 py-12 md:py-20">
    <div class="text-center mb-12">
      <p class="text-leather-600 text-sm font-medium tracking-wide uppercase mb-3">
        Связь
      </p>
      <h1 class="text-3xl md:text-4xl font-semibold text-leather-900 mb-4">
        Контакты
      </h1>
      <p class="text-leather-700 max-w-xl mx-auto">
        Если вам понравилось какое-то изделие или вы хотите обсудить индивидуальный заказ —
        напишите мне любым удобным способом.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-8">
      <!-- Контактная информация -->
      <div class="bg-white p-6 rounded-xl border border-leather-100">
        <h2 class="text-xl font-semibold text-leather-900 mb-6">
          Как со мной связаться
        </h2>

        <div class="space-y-5">
          <!-- Телефон 
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-lg bg-leather-100 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-leather-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>

            </div>
            <div>
              <p class="text-sm font-medium text-leather-900">Телефон</p>
              <a href="tel:+70000000000" class="text-leather-700 hover:text-leather-900 transition">
                +7 (000) 000-00-00
              </a>
              <p class="text-xs text-leather-500 mt-1">Звонки и сообщения в мессенджеры</p>
            </div>
          </div>
-->
          <!-- Email -->
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-lg bg-leather-100 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-leather-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <div>
              <p class="text-sm font-medium text-leather-900">Email</p>
              <a href="mailto:your@email.com" class="text-leather-700 hover:text-leather-900 transition">
                fvv.alfa@yandex.ru
              </a>
              <p class="text-xs text-leather-500 mt-1">Отвечаю в течение 1-2 дней</p>
            </div>
          </div>

          <!-- Мессенджеры -->
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-lg bg-leather-100 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-leather-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
              </svg>
            </div>
            <div>
              <p class="text-sm font-medium text-leather-900">Мессенджеры</p>
              <div class="flex gap-3 mt-2">
                <a href="https://t.me/glukland" class="text-sm text-leather-700 hover:text-leather-900 transition">Telegram</a>
                <a href="https://max.ru/u/f9LHodD0cOJf2ravGVa1zfqQsi0FNHo9GxEsHzbRt_i1FZ1mBC3YSDlXCdI" class="text-sm text-leather-700 hover:text-leather-900 transition">MAX</a>
              </div>
            </div>
          </div>

          <!-- Соцсети 
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-lg bg-leather-100 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-leather-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
              </svg>
            </div>
            <div>
              <p class="text-sm font-medium text-leather-900">Социальные сети</p>
              <div class="flex gap-3 mt-2">
                
                <a href="#" class="text-sm text-leather-700 hover:text-leather-900 transition">VK</a>
              </div>
            </div>
          </div>
          -->
        </div>
      </div>
      <!-- Форма обратной связи -->
      <div class="bg-white p-6 rounded-xl border border-leather-100">
        <h2 class="text-xl font-semibold text-leather-900 mb-6">
          Написать сообщение
        </h2>

        <form
          action="https://formspree.io/f/mwlebzyp"
          method="POST"
          class="space-y-4"
        >
          <div>
            <label for="name" class="block text-sm font-medium text-leather-700 mb-2">
              Ваше имя
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full px-4 py-2 rounded-lg border border-leather-200 focus:outline-none focus:ring-2 focus:ring-leather-400 focus:border-transparent"
              placeholder="Как к вам обращаться"
            />
          </div>

          <div>
            <label for="contact" class="block text-sm font-medium text-leather-700 mb-2">
              Контакт для связи
            </label>
            <input
              type="text"
              id="contact"
              name="contact"
              required
              class="w-full px-4 py-2 rounded-lg border border-leather-200 focus:outline-none focus:ring-2 focus:ring-leather-400 focus:border-transparent"
              placeholder="Телефон, email или мессенджер"
            />
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-leather-700 mb-2">
              Сообщение
            </label>
            <textarea
              id="message"
              name="message"
              rows="4"
              required
              class="w-full px-4 py-2 rounded-lg border border-leather-200 focus:outline-none focus:ring-2 focus:ring-leather-400 focus:border-transparent resize-none"
              placeholder="Расскажите, что вас интересует"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full px-6 py-3 rounded-lg bg-leather-800 text-white font-medium hover:bg-leather-900 transition"
          >
            Отправить
          </button>
        </form>
      </div>
    </div>

    <!-- Примечание -->
    <div class="mt-12 p-6 bg-leather-100 rounded-lg text-center">
      <p class="text-leather-700">
        📝 <strong>Примечание:</strong> Замените контактные данные на свои.
        Для работы формы настройте отправку через сервис вроде Formspree или EmailJS.
      </p>
    </div>
  </section>
</BaseLayout>