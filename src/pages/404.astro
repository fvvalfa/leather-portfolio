---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Страница не найдена">
  <section class="max-w-xl mx-auto px-4 py-24 text-center">
    <p class="text-6xl font-semibold text-leather-300 mb-4">404</p>
    <h1 class="text-2xl font-semibold text-leather-900 mb-3">
      Страница не найдена
    </h1>
    <p class="text-leather-600 mb-8">
      Такой страницы нет. Возможно, ссылка устарела или адрес написан с ошибкой.
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/"
        class="inline-flex px-6 py-3 rounded-lg bg-leather-800 text-white font-medium hover:bg-leather-900 transition"
      >
        На главную
      </a>
      <a
        href="/works"
        class="inline-flex px-6 py-3 rounded-lg border border-leather-300 text-leather-800 font-medium hover:bg-leather-100 transition"
      >
        Смотреть работы
      </a>
    </div>
  </section>
</BaseLayout>