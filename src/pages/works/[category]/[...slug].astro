---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import WorkGallery from '../../../components/WorkGallery.astro';
import { getCategoryLabel, isCategoryId } from '../../../lib/categories';

export async function getStaticPaths() {
  const works = await getCollection('works', (entry) => !entry.data.draft);
  return works.map((work) => ({
    params: {
      category: work.data.category,
      slug: work.id,
    },
    props: { work },
  }));
}

const { work } = Astro.props;
const { Content } = await render(work);
const { category } = Astro.params;
const allImages = [work.data.cover, ...(work.data.images ?? [])];
---

<BaseLayout
  title={`${work.data.title} — Изделия из кожи`}
  description={work.data.description}
  image={work.data.cover.src}
>
  <article class="w-full px-5 md:px-10 xl:px-16 py-12 md:py-16">
    <div class="max-w-5xl">
      <div class="flex flex-wrap gap-3 text-sm text-leather-600 mb-8">
        <a href="/works" class="hover:text-leather-800">Работы</a>
        <span>/</span>
        {category && isCategoryId(category) && (
          <>
            <a href={`/works/${category}`} class="hover:text-leather-800">
              {getCategoryLabel(category)}
            </a>
            <span>/</span>
          </>
        )}
        <span class="text-leather-800">{work.data.title}</span>
      </div>

      <h1 class="text-3xl md:text-5xl font-semibold text-leather-900 mb-4">
        {work.data.title}
      </h1>
      <p class="text-leather-600 text-lg mb-10 max-w-2xl">
        {work.data.description}
      </p>
    </div>

    {/* Галерея шире текста */}
    <div class="max-w-6xl mx-auto mb-12">
  <WorkGallery images={allImages} title={work.data.title} />
  </div>

    <div class="max-w-5xl">
      {work.data.materials.length > 0 && (
        <div class="mb-8">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-leather-500 mb-3">
            Материалы
          </h2>
          <ul class="flex flex-wrap gap-2">
            {work.data.materials.map((item) => (
              <li class="px-3 py-1.5 rounded-full bg-leather-100 text-sm text-leather-800">
                {item}
              </li>
            ))}
          </ul>
        </div>
      )}

      {work.data.techniques && work.data.techniques.length > 0 && (
        <div class="mb-10">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-leather-500 mb-3">
            Техники
          </h2>
          <ul class="flex flex-wrap gap-2">
            {work.data.techniques.map((item) => (
              <li class="px-3 py-1.5 rounded-full bg-leather-100 text-sm text-leather-800">
                {item}
              </li>
            ))}
          </ul>
        </div>
      )}

      <div class="prose max-w-none text-leather-800 leading-relaxed">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>