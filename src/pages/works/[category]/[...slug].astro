---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import WorkGallery from '../../../components/WorkGallery.astro';
import { getCategoryLabel, isCategoryId } from '../../../lib/categories';

export async function getStaticPaths() {
  const works = await getCollection('works', (entry) => !entry.data.draft);
  return works.map((work) => ({
    params: {
      category: work.data.category,
      slug: work.id,
    },
    props: { work },
  }));
}

const { work } = Astro.props;
const { Content } = await render(work);
const { category } = Astro.params;
const allImages = [work.data.cover, ...(work.data.images ?? [])];

// Похожие работы: та же категория, без текущей, максимум 4
const relatedWorks = (
  await getCollection(
    'works',
    (entry) =>
      !entry.data.draft &&
      entry.data.category === work.data.category &&
      entry.id !== work.id
  )
)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);
---

<BaseLayout
  title={`${work.data.title} — Изделия из кожи`}
  description={work.data.description}
  image={work.data.cover.src}
>
  <article class="w-full px-5 md:px-10 xl:px-16 py-12 md:py-16">
    <!-- Хлебные крошки -->
    <div class="max-w-5xl mb-8">
      <nav class="flex flex-wrap items-center gap-2 text-sm text-leather-600" aria-label="Навигация">
        <a href="/works" class="hover:text-leather-900 transition">Работы</a>
        <span class="text-leather-400">/</span>
        {category && isCategoryId(category) && (
          <>
            <a href={`/works/${category}`} class="hover:text-leather-900 transition">
              {getCategoryLabel(category)}
            </a>
            <span class="text-leather-400">/</span>
          </>
        )}
        <span class="text-leather-800 font-medium">{work.data.title}</span>
      </nav>
    </div>

    <!-- Заголовок + описание -->
    <div class="max-w-5xl mb-10">
      <p class="text-sm font-medium tracking-wide uppercase text-leather-500 mb-3">
        {getCategoryLabel(work.data.category)}
      </p>
      <h1 class="text-3xl md:text-5xl font-semibold text-leather-900 mb-4 tracking-tight">
        {work.data.title}
      </h1>
      <p class="text-leather-600 text-lg leading-relaxed max-w-2xl">
        {work.data.description}
      </p>
    </div>

    <!-- Галерея -->
    <div class="max-w-6xl mx-auto mb-14">
      <WorkGallery images={allImages} title={work.data.title} />
    </div>

    <!-- Материалы, техники, текст -->
    <div class="max-w-5xl">
      <div class="grid gap-10 md:grid-cols-[1fr_1.4fr] md:gap-14 mb-14">
        <!-- Левая колонка: мета -->
        <div class="space-y-8">
          {work.data.materials.length > 0 && (
            <div>
              <h2 class="text-xs font-semibold uppercase tracking-[0.15em] text-leather-500 mb-3">
                Материалы
              </h2>
              <ul class="flex flex-wrap gap-2">
                {work.data.materials.map((item) => (
                  <li class="px-3 py-1.5 rounded-full bg-leather-100 text-sm text-leather-800">
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          )}

          {work.data.techniques && work.data.techniques.length > 0 && (
            <div>
              <h2 class="text-xs font-semibold uppercase tracking-[0.15em] text-leather-500 mb-3">
                Техники
              </h2>
              <ul class="flex flex-wrap gap-2">
                {work.data.techniques.map((item) => (
                  <li class="px-3 py-1.5 rounded-full bg-leather-100 text-sm text-leather-800">
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          )}

          <div>
            <h2 class="text-xs font-semibold uppercase tracking-[0.15em] text-leather-500 mb-3">
              Дата
            </h2>
            <p class="text-sm text-leather-700">
              {work.data.date.toLocaleDateString('ru-RU', {
                year: 'numeric',
                month: 'long',
              })}
            </p>
          </div>
        </div>

        <!-- Правая колонка: описание -->
        <div class="prose prose-leather max-w-none text-leather-800 leading-relaxed">
          <Content />
        </div>
      </div>
    </div>

    <!-- Похожие работы -->
    {relatedWorks.length > 0 && (
      <section class="max-w-6xl mx-auto mt-6 pt-14 border-t border-leather-200">
        <div class="flex items-end justify-between mb-8">
          <h2 class="text-2xl md:text-3xl font-semibold text-leather-900">
            Ещё из этой категории
          </h2>
          {category && isCategoryId(category) && (
            <a
              href={`/works/${category}`}
              class="text-sm font-medium text-leather-600 hover:text-leather-900 transition"
            >
              Все →
            </a>
          )}
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-5 md:gap-6">
          {relatedWorks.map((item) => (
            <a
              href={`/works/${item.data.category}/${item.id}`}
              class="group block"
            >
              <div class="overflow-hidden rounded-lg bg-leather-100 mb-3 aspect-[4/5]">
                <Image
                  src={item.data.cover}
                  alt={item.data.title}
                  class="w-full h-full object-cover group-hover:scale-[1.03] transition duration-500"
                />
              </div>
              <h3 class="font-medium text-leather-900 group-hover:text-leather-700 transition text-sm md:text-base">
                {item.data.title}
              </h3>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>