---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  categoryList,
  getCategoryLabel,
  getCategoryDescription,
  isCategoryId,
} from '../../../lib/categories';

export async function getStaticPaths() {
  return categoryList.map((cat) => ({
    params: { category: cat.id },
  }));
}

const { category } = Astro.params;

if (!category || !isCategoryId(category)) {
  return Astro.redirect('/works');
}

const works = (
  await getCollection(
    'works',
    (entry) => !entry.data.draft && entry.data.category === category
  )
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const title = getCategoryLabel(category);
const description = getCategoryDescription(category);
---

<BaseLayout title={`${title} — Изделия из кожи`} description={description}>
  <section class="w-full px-5 md:px-10 xl:px-16 py-12 md:py-16">
    <div class="mb-10">
      <a
        href="/works"
        class="text-sm text-leather-600 hover:text-leather-800 mb-4 inline-block"
      >
        ← Все работы
      </a>

      <h1 class="text-3xl md:text-5xl font-semibold text-leather-900 mb-2">
        {title}
      </h1>

      {description && (
        <p class="text-leather-600 max-w-2xl mb-6">{description}</p>
      )}

      <div class="flex flex-wrap gap-2">
        <a
          href="/works"
          class="px-4 py-2 rounded-full bg-leather-100 text-leather-800 text-sm font-medium hover:bg-leather-200 transition"
        >
          Все
        </a>
        {categoryList.map((cat) => (
          <a
            href={`/works/${cat.id}`}
            class:list={[
              'px-4 py-2 rounded-full text-sm font-medium transition',
              cat.id === category
                ? 'bg-leather-800 text-white'
                : 'bg-leather-100 text-leather-800 hover:bg-leather-200',
            ]}
          >
            {cat.label}
          </a>
        ))}
      </div>
    </div>

    {works.length === 0 ? (
      <p class="text-leather-600">В этой категории пока нет работ.</p>
    ) : (
      <div class="masonry">
        {works.map((work) => (
          <a
            href={`/works/${work.data.category}/${work.id}`}
            class="masonry-item group block"
          >
            <div class="overflow-hidden bg-leather-100 mb-3">
              <Image
                src={work.data.cover}
                alt={work.data.title}
                class="w-full h-auto object-cover group-hover:scale-[1.02] transition duration-500"
              />
            </div>
            <h2 class="font-medium text-leather-900 group-hover:text-leather-700 transition">
              {work.data.title}
            </h2>
            <p class="text-sm text-leather-600 line-clamp-2 mt-0.5">
              {work.data.description}
            </p>
          </a>
        ))}
      </div>
    )}
  </section>
</BaseLayout>