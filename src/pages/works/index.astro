---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';

const works = (await getCollection('works', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Работы — Изделия из кожи">
  <section class="max-w-6xl mx-auto px-4 py-16">
    <div class="mb-12">
      <h1 class="text-3xl md:text-4xl font-semibold text-leather-900 mb-3">
        Работы
      </h1>
      <p class="text-leather-600 max-w-xl">
        Изделия, сделанные вручную. Каждое — с вниманием к материалу и деталям.
      </p>
    </div>

    {works.length === 0 ? (
      <p class="text-leather-600">Пока нет опубликованных работ.</p>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {works.map((work) => (
          <a
            href={`/works/${work.id}`}
            class="group block rounded-xl overflow-hidden border border-leather-200 bg-white hover:shadow-lg transition"
          >
            <div class="aspect-[4/3] overflow-hidden bg-leather-100">
              <Image
                src={work.data.cover}
                alt={work.data.title}
                class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
              />
            </div>
            <div class="p-5">
              <h2 class="font-semibold text-leather-900 mb-1 group-hover:text-leather-700 transition">
                {work.data.title}
              </h2>
              <p class="text-sm text-leather-600 line-clamp-2">
                {work.data.description}
              </p>
            </div>
          </a>
        ))}
      </div>
    )}
  </section>
</BaseLayout>