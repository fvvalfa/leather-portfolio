---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categoryList, getCategoryLabel } from '../../lib/categories';

const works = (await getCollection('works', (entry) => !entry.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout title="Работы — Изделия из кожи">
  <section class="max-w-6xl mx-auto px-4 py-16">
    <div class="mb-10">
      <h1 class="text-3xl md:text-4xl font-semibold text-leather-900 mb-3">Работы</h1>
      <p class="text-leather-600 max-w-xl mb-8">
        Изделия, сделанные вручную. Каждое — с вниманием к материалу и деталям.
      </p>

      <div class="flex flex-wrap gap-2">
        <a
          href="/works"
          class="px-4 py-2 rounded-full bg-leather-800 text-white text-sm font-medium"
        >
          Все
        </a>
        {categoryList.map((cat) => (
          <a
            href={`/works/${cat.id}`}
            class="px-4 py-2 rounded-full bg-leather-100 text-leather-800 text-sm font-medium hover:bg-leather-200 transition"
          >
            {cat.label}
          </a>
        ))}
      </div>
    </div>

    {works.length === 0 ? (
  <p class="text-leather-600">Пока нет опубликованных работ.</p>
) : (
  <div class="masonry">
    {works.map((work) => (
      <a
        href={`/works/${work.data.category}/${work.id}`}
        class="masonry-item group block rounded-xl overflow-hidden border border-leather-200 bg-white hover:shadow-lg transition"
      >
        <div class="overflow-hidden bg-leather-100">
          <Image
            src={work.data.cover}
            alt={work.data.title}
            class="w-full h-auto object-cover group-hover:scale-[1.03] transition duration-500"
          />
        </div>
        <div class="p-5">
          <p class="text-xs text-leather-500 mb-1">
            {getCategoryLabel(work.data.category)}
          </p>
          <h2 class="font-semibold text-leather-900 mb-1 group-hover:text-leather-700 transition">
            {work.data.title}
          </h2>
          <p class="text-sm text-leather-600 line-clamp-2">
            {work.data.description}
          </p>
        </div>
      </a>
    ))}
  </div>
)}
  </section>
</BaseLayout>