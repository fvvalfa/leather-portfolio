---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categoryList, getCategoryLabel } from '../../lib/categories';

const works = (await getCollection('works', (entry) => !entry.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout title="Работы — Изделия из кожи">
  <section class="w-full px-5 md:px-10 xl:px-16 py-12 md:py-16">
    <div class="mb-10">
      <h1 class="text-3xl md:text-5xl font-semibold text-leather-900 mb-3">Работы</h1>
      <p class="text-leather-600 max-w-2xl mb-8">
        Изделия, сделанные вручную. Каждое — с вниманием к материалу и деталям.
      </p>

      <div class="flex flex-wrap gap-2">
        <a href="/works" class="px-4 py-2 rounded-full bg-leather-800 text-white text-sm font-medium">
          Все
        </a>
        {categoryList.map((cat) => (
          <a
            href={`/works/${cat.id}`}
            class="px-4 py-2 rounded-full bg-leather-100 text-leather-800 text-sm font-medium hover:bg-leather-200 transition"
          >
            {cat.label}
          </a>
        ))}
      </div>
    </div>

    {works.length === 0 ? (
      <p class="text-leather-600">Пока нет опубликованных работ.</p>
    ) : (
      <div class="masonry">
        {works.map((work) => (
          <a
            href={`/works/${work.data.category}/${work.id}`}
            class="masonry-item group block"
          >
            <div class="overflow-hidden bg-leather-100 mb-3">
              <Image
                src={work.data.cover}
                alt={work.data.title}
                class="w-full h-auto object-cover group-hover:scale-[1.02] transition duration-500"
              />
            </div>
            <p class="text-xs text-leather-500 mb-0.5">
              {getCategoryLabel(work.data.category)}
            </p>
            <h2 class="font-medium text-leather-900 group-hover:text-leather-700 transition">
              {work.data.title}
            </h2>
          </a>
        ))}
      </div>
    )}
  </section>
</BaseLayout>