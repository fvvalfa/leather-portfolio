---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const works = await getCollection('works', ({ data }) => !data.draft);
  return works.map((work) => ({
    params: { slug: work.id },
    props: { work },
  }));
}

const { work } = Astro.props;
const { Content } = await render(work);
---

<BaseLayout title={`${work.data.title} — Изделия из кожи`} description={work.data.description}>
  <article class="max-w-4xl mx-auto px-4 py-16">
    <a href="/works" class="text-sm text-leather-600 hover:text-leather-800 mb-8 inline-block">
      ← Все работы
    </a>

    <h1 class="text-3xl md:text-4xl font-semibold text-leather-900 mb-4">
      {work.data.title}
    </h1>
    <p class="text-leather-600 mb-8 max-w-2xl">
      {work.data.description}
    </p>

    <div class="rounded-xl overflow-hidden mb-10 border border-leather-200">
      <Image
        src={work.data.cover}
        alt={work.data.title}
        class="w-full h-auto object-cover"
      />
    </div>

    {work.data.materials.length > 0 && (
      <div class="mb-8">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-leather-500 mb-2">
          Материалы
        </h2>
        <ul class="flex flex-wrap gap-2">
          {work.data.materials.map((item) => (
            <li class="px-3 py-1 rounded-full bg-leather-100 text-sm text-leather-800">
              {item}
            </li>
          ))}
        </ul>
      </div>
    )}

    {work.data.techniques && work.data.techniques.length > 0 && (
      <div class="mb-10">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-leather-500 mb-2">
          Техники
        </h2>
        <ul class="flex flex-wrap gap-2">
          {work.data.techniques.map((item) => (
            <li class="px-3 py-1 rounded-full bg-leather-100 text-sm text-leather-800">
              {item}
            </li>
          ))}
        </ul>
      </div>
    )}

    <div class="prose prose-leather max-w-none text-leather-800">
      <Content />
    </div>
  </article>
</BaseLayout>